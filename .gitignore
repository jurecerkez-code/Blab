node_modules
dist

# Packaged desktop builds. Rebuild them with `npm run package`.
release
Blab-Setup-*.exe
Blab-*.dmg

# Anyone's recordings, if they point Blab at a folder inside the checkout.
# Audio and notes are the user's, and never the repository's.
recordings
# Blab does not write a `recordings` folder — it writes one timestamped folder
# per take (2026-08-04_2058_title/) straight into whichever vault folder was
# picked. Pointing Blab at the checkout therefore dropped audio.webm and
# notes.md in the repository root, where the line above never reached them.
20??-??-??_*/

# Fetched once by `npm run setup`. Not source, and too big for git.
public/models
public/ort

# Playwright output. Regenerated by `npm test`.
test-results
playwright-report

# Per-machine tool settings. Local absolute paths, and one person's choices
# about what a tool may run — nothing another clone should inherit.
.claude/settings.local.json

# graphify's knowledge graph. Regenerated from the source it describes, so it
# is derived output, and it goes stale the moment anyone commits without it.
graphify-out
